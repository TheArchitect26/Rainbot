# No API key is needed for offline gameplay, skins, progression or the PWA.

# Optional shared leaderboard URL. Web builds default to the same-origin
# /api/leaderboard route. Android needs an absolute public HTTPS endpoint.
# Set before npm run build / npm run android:sync, then rebuild the app.
# VITE_LEADERBOARD_URL=https://game.example.com/api/leaderboard

# Self-hosted service (Node 24+). Keep the database on persistent storage.
# HOST=127.0.0.1
# PORT=8787
# LEADERBOARD_DB=./data/leaderboard.sqlite
# SERVE_WEB=true
# ALLOWED_ORIGINS=https://game.example.com,https://localhost
# TRUST_PROXY_HOPS=1
